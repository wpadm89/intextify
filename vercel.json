{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/residential", "destination": "/residential/index.html" },
    { "source": "/blog/:slug", "destination": "/blog" },
    { "source": "/guides/:slug", "destination": "/guides" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-scrape",
      "schedule": "0 0 * * *"
    }
  ]
}
